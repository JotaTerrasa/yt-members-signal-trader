PORT=5178
NODE_ENV=production
TZ=Europe/Madrid
PUBLISH_ADDRESS=127.0.0.1

# Configura ambas variables antes de exponer la UI mediante un túnel.
APP_BASIC_USER=
APP_BASIC_PASSWORD=

# Mantener false en escritorio si quieres ver Chromium para iniciar sesion.
# Usar true en Docker o servidores sin pantalla.
PLAYWRIGHT_HEADLESS=true

# Solo si el entorno lo exige. No es necesario con la imagen oficial de Playwright.
PLAYWRIGHT_NO_SANDBOX=false

# Informes de estrategia: 1 evita llamadas a BingX y usa solo eventos locales.
STRATEGY_STUDY_OFFLINE=0
